# Copy to backend/.env
# Choose ONE method to provide service account credentials.

# Method A (recommended): set path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Method B: set raw JSON (as a single-line or escaped string)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: Firebase project id (used in some setups)
FIREBASE_PROJECT_ID=

# CORS (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# DRF / Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

